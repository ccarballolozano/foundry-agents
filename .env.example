# Foundry project endpoint (e.g. https://<project>.foundry.azureml.com)
FOUNDRY_PROJECT_ENDPOINT=

# Deployment name of the model to use (e.g. gpt-5.4-mini)
AZURE_AI_MODEL_DEPLOYMENT_NAME=

# Optional prompt variant: baseline (default), mistake or new-version
AGENT_PROMPT=

# --- hr-agent (agents/hr-agent/) ---
# Toolbox used when hr-agent is hosted (default: hr-agent-toolbox).
# It reaches the handbook knowledge base with the agent's own identity.
HR_AGENT_TOOLBOX=
# Toolbox used when hr-agent runs locally (default: hr-agent-toolbox-dev).
# It reaches the handbook knowledge base with your own `az login` identity.
HR_AGENT_DEV_TOOLBOX=
# Note: AGENT_PROMPT above is also read by hr-agent locally. hr-agent ships `baseline`
# (default) and the demo-only `leaky`, so leave AGENT_PROMPT empty when running hr-agent.
# The hosted hr-agent reads its variant from the azd variable HR_AGENT_PROMPT instead.

# --- it-agent (agents/it-agent/) ---
# The hosted it-agent reads its prompt variant from the azd variable IT_AGENT_PROMPT
# (`azd env set IT_AGENT_PROMPT baseline`); empty means baseline. Locally, it-agent reads
# AGENT_PROMPT above, so leave that empty when running it-agent too.
IT_AGENT_PROMPT=
